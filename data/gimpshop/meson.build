# GIMPshop branding: splash screen and logo.
# The .svg files are the editable sources, the .png/.ico files are
# rendered from them (see the comment in gimpshop-splash.svg).
install_data(
  [ 'gimpshop-splash.png', 'gimpshop-logo-256.png', 'gimpshop-logo.svg' ],
  install_dir: gimpdatadir / 'images',
)
